<script>

function showPage(pageId) {

    let pages = document.querySelectorAll(".page");

    pages.forEach(function(page) {
        page.classList.remove("active");
    });

    document.getElementById(pageId).classList.add("active");

    window.scrollTo(0, 0);
}


function moveNo() {

    let button = document.getElementById("noBtn");

    let x = Math.floor(Math.random() * 300) - 150;
    let y = Math.floor(Math.random() * 200) - 100;

    button.style.transform =
        "translate(" + x + "px, " + y + "px)";
}


function wrong(button) {

    button.innerHTML = "NOPE 😭";

    setTimeout(function() {
        button.innerHTML = button.getAttribute("data-original") || "TRY AGAIN";
    }, 700);
}


function correct(currentPage, nextPage) {

    showPage(nextPage);
}

</script>

